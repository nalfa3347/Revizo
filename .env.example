# ==============================================================================
# REVIZO 2.0 — Variables d'Environnement (Exemple)
# Copier ce fichier sous le nom .env.local pour configurer l'application.
# ATTENTION : Ne JAMAIS committer de clés réelles ou de secrets dans le dépôt.
# ==============================================================================

# Choix du fournisseur de données et d'authentification : 'mock' | 'supabase'
# Par défaut : 'mock' (permet l'exécution locale intégrale sans backend distant)
VITE_DATA_PROVIDER=supabase

# ==============================================================================
# SUPABASE — FRONTEND (autorisé dans le bundle Vite)
# ==============================================================================

# URL publique du projet Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Clé publique anonyme (Anon / Publishable Key)
VITE_SUPABASE_ANON_KEY=
